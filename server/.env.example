# Copy to .env and adjust as needed.
PORT=4000
# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5433/home_services
# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=dev-only-change-me
# Comma separated list of allowed web origins for CORS.
CORS_ORIGIN=http://localhost:5173
